# ─── git-email-migrator configuration ───
# Copy to config.env and edit. config.env is gitignored — keep it that way.

# Email addresses to rewrite AWAY FROM (space-separated).
# Typical case: a company email that is being decommissioned.
OLD_EMAILS="old@company.com"

# The email every matched commit will be rewritten TO.
# Use an address you control permanently (and verify it on GitHub first!).
NEW_EMAIL="you@example.com"

# Safety switch. 1 = audit/clone/rewrite/validate but never push (default).
# Set to 0 only after reviewing a dry run.
DRY_RUN=1

# Which owners to scan. Leave empty to auto-discover: your user account plus
# every organization you belong to. Override to restrict the blast radius:
# ORGS="your-user your-org"
ORGS=""

# Repos to skip entirely (space-separated owner/name).
# Add repos you don't own the history of (e.g. other people's repos you
# contributed to — you can't rewrite those anyway).
EXCLUDE_REPOS=""

# Scan exactly these repos and nothing else (space-separated owner/name).
# Overrides ORGS. Useful for a trial run on one repo before going wide.
ONLY_REPOS=""

# How audit/verify scan for old emails:
#   api   — GitHub commits API, default branch only. Fast, no clones.
#   clone — bare-clone every repo and check ALL refs (branches + tags).
#           Slower, but the only complete answer. Use it for the final verify.
SCAN_MODE="api"

# For `./migrate.sh sync`: directories that contain your local clones.
# LOCAL_ROOTS="$HOME/projects $HOME/work"
LOCAL_ROOTS=""
